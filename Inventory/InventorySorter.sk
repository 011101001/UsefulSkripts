options:
    prefix: &8[&bSort&8] &7

command /sort:
    executable by: players
    cooldown: 3 seconds
    trigger:
        delete {_stacks::*}
        loop 27 times:
            set {_index} to loop-number + 8
            set {_stack} to slot {_index} of player
            if {_stack} is not air:
                add {_stack} to {_stacks::*}
        if size of {_stacks::*} is 0:
            send "{@prefix}&eYour main inventory is empty."
            stop

        sort {_stacks::*} based on "%type of input%"
        loop 27 times:
            set {_index} to loop-number + 8
            clear slot {_index} of player

        set {_index} to 9
        loop {_stacks::*}:
            set slot {_index} of player to loop-value
            add 1 to {_index}
        send "{@prefix}&aMain inventory sorted. Your hotbar was left alone."
