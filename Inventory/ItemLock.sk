options:
    prefix: &8[&6ItemLock&8] &7

command /itemlock:
    executable by: players
    trigger:
        if player's tool is air:
            send "{@prefix}&cHold the item type you want to protect."
            stop
        set {_kind} to "%type of player's tool%"
        if {usefulskripts::itemlock::%uuid of player%::%{_kind}%} is true:
            delete {usefulskripts::itemlock::%uuid of player%::%{_kind}%}
            send "{@prefix}&aUnlocked drops for %{_kind}%."
        else:
            set {usefulskripts::itemlock::%uuid of player%::%{_kind}%} to true
            send "{@prefix}&eLocked Q-drops for %{_kind}%."

on drop:
    set {_kind} to "%type of event-item%"
    if {usefulskripts::itemlock::%uuid of player%::%{_kind}%} is true:
        cancel event
        send "{@prefix}&cThat item type is locked. Use /itemlock while holding it to unlock."
