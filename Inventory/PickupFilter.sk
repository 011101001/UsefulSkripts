options:
    prefix: &8[&3PickupFilter&8] &7

command /pickupfilter [<text>]:
    executable by: players
    trigger:
        if arg-1 is "list":
            if size of {usefulskripts::pickupfilter::%uuid of player%::*} is 0:
                send "{@prefix}&eYour pickup filter is empty."
                stop
            send "{@prefix}&eBlocked items:"
            loop {usefulskripts::pickupfilter::%uuid of player%::*}:
                send "&7- &f%loop-index%"
            stop

        if arg-1 is "clear":
            delete {usefulskripts::pickupfilter::%uuid of player%::*}
            send "{@prefix}&aYour pickup filter was cleared."
            stop

        if arg-1 is set:
            set {_parsed} to arg-1 parsed as item type
            if {_parsed} is not set:
                send "{@prefix}&cUnknown item. Try /pickupfilter diamond or /pickupfilter diamond sword."
                stop
            set {_material} to "%type of {_parsed}%"
        else:
            if player's tool is air:
                send "{@prefix}&eUsage: /pickupfilter <item>, /pickupfilter list, or /pickupfilter clear."
                stop
            set {_material} to "%type of player's tool%"

        if {usefulskripts::pickupfilter::%uuid of player%::%{_material}%} is true:
            delete {usefulskripts::pickupfilter::%uuid of player%::%{_material}%}
            send "{@prefix}&aPickup allowed: &f%{_material}%"
        else:
            set {usefulskripts::pickupfilter::%uuid of player%::%{_material}%} to true
            send "{@prefix}&ePickup blocked: &f%{_material}%"

on player pickup:
    set {_material} to "%type of event-item%"
    if {usefulskripts::pickupfilter::%uuid of player%::%{_material}%} is true:
        cancel event
