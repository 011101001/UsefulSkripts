options:
    recipe-id: usefulskripts:name_tag
    recipe-name: &aCrafted Name Tag

on load:
    register shaped recipe:
        id: "{@recipe-id}"
        result: name tag named "{@recipe-name}"
        shape: " P ", " S ", " I "
        category: "misc"
        ingredients:
            set ingredient of "P" to paper
            set ingredient of "S" to string
            set ingredient of "I" to iron ingot
