# ============================================================
# UsefulSkripts - Telepathy
# Collect mined item drops directly into player inventory when space permits.
# Requires: Skript 2.10+ and a compatible Minecraft server
# ============================================================

options:
    prefix: &8[&dTelepathy&8] &7

# /telepathy [on|off] toggles the feature for each player.
# The preference survives script reloads and restarts.
# Uses the native block-drop event to identify the breaking player.
# This avoids guessing drop ownership from spawn coordinates.
command /telepathy [<text>]:
    executable by: players
    trigger:
        if arg-1 is "on":
            set {telepathy::enabled::%uuid of player%} to true
            send "{@prefix}&aEnabled. Mined drops go to your inventory."
            stop
        if arg-1 is "off":
            delete {telepathy::enabled::%uuid of player%}
            send "{@prefix}&cDisabled. Drops fall normally."
            stop
        if arg-1 is not set:
            if {telepathy::enabled::%uuid of player%} is true:
                delete {telepathy::enabled::%uuid of player%}
                send "{@prefix}&cDisabled. Drops fall normally."
            else:
                set {telepathy::enabled::%uuid of player%} to true
                send "{@prefix}&aEnabled. Mined drops go to your inventory."
            stop
        send "{@prefix}&eUsage: /telepathy [on|off]"

# Ordinary vanilla block drops have an exact player in this event.
# A whole stack is transferred only when the inventory has room.
# Otherwise it is left on the ground so nothing is destroyed.
on block drop:
    if event-player's gamemode is creative:
        stop
    if {telepathy::enabled::%uuid of event-player%} is not true:
        stop
    loop event-entities:
        set {_stack} to item of loop-entity
        if {_stack} is not air:
            set {_material} to "%type of {_stack}%"
            if {usefulskripts::pickupfilter::%uuid of event-player%::%{_material}%} is true:
                continue
            if event-player has enough space for {_stack}:
                kill loop-entity
                give {_stack} to event-player

# UniversalFortune.sk creates scripted item entities. It sets the
# owner marker only while spawning those drops synchronously.
# No arbitrary player-dropped or long-existing items are collected.
on item spawn:
    if {telepathy::fortune-emitting-player} is not set:
        stop
    set {_recipient} to {telepathy::fortune-emitting-player}
    if {_recipient} is not online:
        stop
    if {telepathy::enabled::%uuid of {_recipient}%} is not true:
        stop
    set {_stack} to item of event-entity
    if {_stack} is air:
        stop
    set {_material} to "%type of {_stack}%"
    if {usefulskripts::pickupfilter::%uuid of {_recipient}%::%{_material}%} is true:
        stop
    if {_recipient} has enough space for {_stack}:
        cancel event
        give {_stack} to {_recipient}
