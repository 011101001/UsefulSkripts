# ============================================================
# UsefulSkripts - Universal Fortune
# Adds an ore-style Fortune multiplier to ordinary block drops.
# Requires: Skript 2.10+ and compatible server
# ============================================================

on break with priority highest:
    if event is cancelled:
        stop
    if player's gamemode is creative:
        stop

    set {_tool} to player's tool
    if {_tool} is air:
        stop

    # Read the actual Fortune level from the tool.
    set {_rawFortune} to level of fortune of {_tool}
    if {_rawFortune} is not set:
        set {_rawFortune} to 0
    set {_fortune} to {_rawFortune}

    # Optional external cap, retained for older mining setups.
    if {mining::config::fortune-max} is set:
        if {_fortune} > {mining::config::fortune-max}:
            set {_fortune} to {mining::config::fortune-max}

    # Silk Touch is deliberately higher priority than the custom bonus.
    if level of silk touch of {_tool} > 0:
        set {_fortune} to 0

    # No special handling needed for tools without applicable Fortune.
    if {_fortune} <= 0:
        stop

    # Keep vanilla handling for storage blocks and blocks with contents,
    # internal inventory data, or special drop side effects.
    if event-block is chest or trapped chest or barrel or hopper or dispenser or dropper or furnace or blast furnace or smoker or brewing stand or ender chest or spawner or beehive or bee nest or lectern or chiseled bookshelf or decorated pot or jukebox or campfire or soul campfire or crafter or trial spawner or vault:
        stop
    if "%type of event-block%" contains "shulker box":
        stop

    # Clone the held tool and remove Fortune from the drop simulation.
    # The player's actual held tool is not intentionally modified.
    set {_normalTool} to {_tool}
    if {_fortune} > 0:
        set level of fortune of {_normalTool} to 0

    set {_drops::*} to drops of event-block using {_normalTool} as player
    if size of {_drops::*} is 0:
        stop

    # Keep vanilla XP, but replace item drops to prevent double Fortune.
    cancel drops of items

    set {_multiplier} to 1
    if {_fortune} > 0:
        set {_roll} to random integer between 0 and ({_fortune} + 1)
        set {_multiplier} to {_roll}
        if {_multiplier} < 1:
            set {_multiplier} to 1

    # This marker exists only while the scripted drops are emitted.
    # Telepathy reads it synchronously for direct inventory pickup.
    set {telepathy::fortune-emitting-player} to player

    loop {_drops::*}:
        set {_original} to loop-value
        set {_remaining} to (item amount of {_original}) * {_multiplier}
        set {_stackMax} to maximum stack size of {_original}
        if {_stackMax} < 1:
            set {_stackMax} to 1

        # Split yields into stacks respecting each item's own max size.
        while {_remaining} > 0:
            set {_size} to {_remaining}
            if {_size} > {_stackMax}:
                set {_size} to {_stackMax}

            set {_chunk} to {_original}
            set item amount of {_chunk} to {_size}

            # Spawn normal drops. Telepathy may collect them if enabled.
            drop {_chunk} at location of event-block

            remove {_size} from {_remaining}

    delete {telepathy::fortune-emitting-player}
