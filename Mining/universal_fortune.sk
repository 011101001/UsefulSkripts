# =========================================================
# UNIVERSAL FORTUNE DROP ENGINE (SEPARATE SKRIPT)
# Put this file next to mining_pickaxes.sk in plugins/Skript/scripts/.
#
# - ALL tools with the real Fortune enchantment use this system.
# - Any ordinary droppable block can benefit (logs, stone, dirt, ores...).
# - A vanilla-ORE-STYLE Fortune roll is used for each block's drops:
#   multiplier = max(1, random integer from 0 to (Fortune + 1)).
#   This is the classic ore-style distribution: Fortune III averages 2.2x.
# - It replaces vanilla item drops so Fortune is NOT applied twice.
# - telepathy.sk collects these custom Fortune drops directly when enabled.
#   The scripts communicate through a temporary drop-owner variable.
# - Silk Touch keeps its normal behavior, without Fortune multiplication.
# - Important: special loot tables (e.g. flint, crop seeds) are not
#   identical to every vanilla Fortune rule; this uses ORE-STYLE scaling.
# - Container / special block entities are excluded for anti-dupe safety.
# - Experience is left to Minecraft (only item drops are replaced).
# =========================================================

on break with priority highest:
    if event is cancelled:
        stop
    if player's gamemode is creative:
        stop

    set {_tool} to player's tool
    if {_tool} is air:
        stop

    # Actual Fortune enchant level, on ANY enchanted item, not only picks.
    set {_rawFortune} to level of fortune of {_tool}
    if {_rawFortune} is not set:
        set {_rawFortune} to 0
    set {_fortune} to {_rawFortune}

    # Cap is controlled by the option in mining_pickaxes.sk.
    if {mining::config::fortune-max} is set:
        if {_fortune} > {mining::config::fortune-max}:
            set {_fortune} to {mining::config::fortune-max}

    # Silk Touch is deliberately higher priority than the custom bonus.
    if level of silk touch of {_tool} > 0:
        set {_fortune} to 0

    # No special handling needed for tools without applicable Fortune.
    if {_fortune} <= 0:
        stop

    # Keep vanilla handling for storage blocks and blocks with contents,
    # internal inventory data, or special drop side effects.
    if event-block is chest or trapped chest or barrel or hopper or dispenser or dropper or furnace or blast furnace or smoker or brewing stand or ender chest or spawner or beehive or bee nest or lectern or chiseled bookshelf or decorated pot or jukebox or campfire or soul campfire or crafter or trial spawner or vault:
        stop
    if "%type of event-block%" contains "shulker box":
        stop

    # Sample correct NORMAL drops with the same tool but WITHOUT Fortune.
    # Skript clones item values when putting them in variables, so the
    # original player's held tool/enchantments are NOT modified.
    set {_normalTool} to {_tool}
    if {_fortune} > 0:
        set level of fortune of {_normalTool} to 0

    set {_drops::*} to drops of event-block using {_normalTool} as player
    if size of {_drops::*} is 0:
        stop

    # Keep the original XP drop but replace its ITEM drops.
    cancel drops of items

    set {_multiplier} to 1
    if {_fortune} > 0:
        set {_roll} to random integer between 0 and ({_fortune} + 1)
        set {_multiplier} to {_roll}
        if {_multiplier} < 1:
            set {_multiplier} to 1

    # The item-spawn event does not otherwise know who owns scripted
    # drops. This marker is set only while this break emits its drops,
    # and is read by the separate telepathy.sk handler synchronously.
    # Fortune still works by itself when telepathy.sk is absent.
    set {telepathy::fortune-emitting-player} to player

    loop {_drops::*}:
        set {_original} to loop-value
        set {_remaining} to (item amount of {_original}) * {_multiplier}
        set {_stackMax} to maximum stack size of {_original}
        if {_stackMax} < 1:
            set {_stackMax} to 1

        # Split yields into stacks respecting each item's own max size.
        while {_remaining} > 0:
            set {_size} to {_remaining}
            if {_size} > {_stackMax}:
                set {_size} to {_stackMax}

            set {_chunk} to {_original}
            set item amount of {_chunk} to {_size}

            # Spawn normal world drops. telepathy.sk cancels the spawn
            # and inserts the stack if that player has inventory space.
            drop {_chunk} at location of event-block

            remove {_size} from {_remaining}

    delete {telepathy::fortune-emitting-player}
