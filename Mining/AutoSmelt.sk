options:
    prefix: &8[&6AutoSmelt&8] &7

command /autosmelt [<text>]:
    executable by: players
    trigger:
        if arg-1 is "on":
            set {usefulskripts::autosmelt::%uuid of player%} to true
            send "{@prefix}&aEnabled."
            stop
        if arg-1 is "off":
            delete {usefulskripts::autosmelt::%uuid of player%}
            send "{@prefix}&cDisabled."
            stop
        if arg-1 is set:
            send "{@prefix}&eUsage: /autosmelt [on|off]"
            stop
        if {usefulskripts::autosmelt::%uuid of player%} is true:
            delete {usefulskripts::autosmelt::%uuid of player%}
            send "{@prefix}&cDisabled."
        else:
            set {usefulskripts::autosmelt::%uuid of player%} to true
            send "{@prefix}&aEnabled."

on block drop with priority lowest:
    if {usefulskripts::autosmelt::%uuid of event-player%} is not true:
        stop
    loop event-entities:
        set {_old} to item of loop-entity
        set {_amount} to item amount of {_old}
        if {_old} is raw iron:
            set {_new} to iron ingot
        else if {_old} is raw gold:
            set {_new} to gold ingot
        else if {_old} is raw copper:
            set {_new} to copper ingot
        else:
            continue
        set item amount of {_new} to {_amount}
        set item of loop-entity to {_new}

on item spawn with priority lowest:
    if {telepathy::fortune-emitting-player} is not set:
        stop
    set {_p} to {telepathy::fortune-emitting-player}
    if {usefulskripts::autosmelt::%uuid of {_p}%} is not true:
        stop
    set {_old} to item of event-entity
    set {_amount} to item amount of {_old}
    if {_old} is raw iron:
        set {_new} to iron ingot
    else if {_old} is raw gold:
        set {_new} to gold ingot
    else if {_old} is raw copper:
        set {_new} to copper ingot
    else:
        stop
    set item amount of {_new} to {_amount}
    set item of event-entity to {_new}
