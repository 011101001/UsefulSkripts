# ============================================================
# UsefulSkripts - AutoCompress
# Compress groups of nine resources into their storage blocks.
# ============================================================

options:
    prefix: &8[&eCompress&8] &7

# /compress performs a one-time conversion.
# /autocompress toggles conversion when inventory contents change.
# No repeating timer or 256-iteration loops are used.
# Each material count is read once, then converted in one batch.
# Full inventories are handled conservatively: conversion is skipped
# when there is no room for the output before inputs are removed.
# Regular material items are expected; special metadata is not checked.
function us_compress(p: player) :: number:
    set {_total} to 0

    # iron ingots -> iron block
    set {_amount} to amount of iron ingots in {_p}'s inventory
    set {_blocks} to floor({_amount} / 9)
    if {_blocks} > 0:
        if {_p} has enough space for {_blocks} iron block:
            set {_remove} to {_blocks} * 9
            remove {_remove} iron ingots from {_p}
            give {_blocks} iron block to {_p}
            add {_blocks} to {_total}

    # gold ingots -> gold block
    set {_amount} to amount of gold ingots in {_p}'s inventory
    set {_blocks} to floor({_amount} / 9)
    if {_blocks} > 0:
        if {_p} has enough space for {_blocks} gold block:
            set {_remove} to {_blocks} * 9
            remove {_remove} gold ingots from {_p}
            give {_blocks} gold block to {_p}
            add {_blocks} to {_total}

    # copper ingots -> copper block
    set {_amount} to amount of copper ingots in {_p}'s inventory
    set {_blocks} to floor({_amount} / 9)
    if {_blocks} > 0:
        if {_p} has enough space for {_blocks} copper block:
            set {_remove} to {_blocks} * 9
            remove {_remove} copper ingots from {_p}
            give {_blocks} copper block to {_p}
            add {_blocks} to {_total}

    # diamonds -> diamond block
    set {_amount} to amount of diamonds in {_p}'s inventory
    set {_blocks} to floor({_amount} / 9)
    if {_blocks} > 0:
        if {_p} has enough space for {_blocks} diamond block:
            set {_remove} to {_blocks} * 9
            remove {_remove} diamonds from {_p}
            give {_blocks} diamond block to {_p}
            add {_blocks} to {_total}

    # emeralds -> emerald block
    set {_amount} to amount of emeralds in {_p}'s inventory
    set {_blocks} to floor({_amount} / 9)
    if {_blocks} > 0:
        if {_p} has enough space for {_blocks} emerald block:
            set {_remove} to {_blocks} * 9
            remove {_remove} emeralds from {_p}
            give {_blocks} emerald block to {_p}
            add {_blocks} to {_total}

    # coal -> coal block
    set {_amount} to amount of coal in {_p}'s inventory
    set {_blocks} to floor({_amount} / 9)
    if {_blocks} > 0:
        if {_p} has enough space for {_blocks} coal block:
            set {_remove} to {_blocks} * 9
            remove {_remove} coal from {_p}
            give {_blocks} coal block to {_p}
            add {_blocks} to {_total}

    # redstone -> redstone block
    set {_amount} to amount of redstone in {_p}'s inventory
    set {_blocks} to floor({_amount} / 9)
    if {_blocks} > 0:
        if {_p} has enough space for {_blocks} redstone block:
            set {_remove} to {_blocks} * 9
            remove {_remove} redstone from {_p}
            give {_blocks} redstone block to {_p}
            add {_blocks} to {_total}

    # lapis lazuli -> lapis block
    set {_amount} to amount of lapis lazuli in {_p}'s inventory
    set {_blocks} to floor({_amount} / 9)
    if {_blocks} > 0:
        if {_p} has enough space for {_blocks} lapis block:
            set {_remove} to {_blocks} * 9
            remove {_remove} lapis lazuli from {_p}
            give {_blocks} lapis block to {_p}
            add {_blocks} to {_total}

    return {_total}

# A manual one-time conversion, independent of the auto toggle.
command /compress:
    executable by: players
    trigger:
        set {_made} to us_compress(player)
        send "{@prefix}&aMade %{_made}% storage blocks."

command /autocompress [<text>]:
    executable by: players
    trigger:
        if arg-1 is "on":
            set {usefulskripts::autocompress::%uuid of player%} to true
            set {_made} to us_compress(player)
            send "{@prefix}&aEnabled. Made %{_made}% storage blocks."
            stop
        if arg-1 is "off":
            delete {usefulskripts::autocompress::%uuid of player%}
            send "{@prefix}&cDisabled."
            stop
        if arg-1 is set:
            send "{@prefix}&eUsage: /autocompress [on|off]"
            stop
        if {usefulskripts::autocompress::%uuid of player%} is true:
            delete {usefulskripts::autocompress::%uuid of player%}
            send "{@prefix}&cDisabled."
        else:
            set {usefulskripts::autocompress::%uuid of player%} to true
            set {_made} to us_compress(player)
            send "{@prefix}&aEnabled. Made %{_made}% storage blocks."

# Avoid recursive conversions when changing inventory slots.
on load:
    delete {usefulskripts::autocompress::busy::*}

on inventory slot change:
    if {usefulskripts::autocompress::%uuid of player%} is not true:
        stop
    if {usefulskripts::autocompress::busy::%uuid of player%} is true:
        stop
    set {usefulskripts::autocompress::busy::%uuid of player%} to true
    wait 1 tick
    if player is online:
        us_compress(player)
    delete {usefulskripts::autocompress::busy::%uuid of player%}
