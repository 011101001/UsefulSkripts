# ============================================================
# UsefulSkripts - DurabilityAlerts
# Warn a player when a damaged item is nearly broken.
# Requires: Skript 2.10+ and a compatible Minecraft server
# ============================================================

options:
    warning-remaining: 25
    warning-cooldown: 12 seconds
    prefix: &8[&cDurability&8] &7

# Works with damageable items. The warning is throttled per player
# to avoid chat spam from repeated hits or rapid mining.
on item damage:
    if event-player is not set:
        stop
    set {_max} to maximum durability of event-item
    if {_max} <= 0:
        stop
    set {_remaining} to {_max} - damage value of event-item - damage
    if {_remaining} > {@warning-remaining}:
        stop
    if {usefulskripts::durability::warned::%uuid of event-player%} is set:
        if difference between now and {usefulskripts::durability::warned::%uuid of event-player%} < {@warning-cooldown}:
            stop
    set {usefulskripts::durability::warned::%uuid of event-player%} to now
    send "{@prefix}&e%type of event-item% has about &c%{_remaining}% &edurability remaining!" to event-player
