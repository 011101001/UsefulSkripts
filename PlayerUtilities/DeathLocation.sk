options:
    prefix: &8[&dDeathLoc&8] &7

on death of player:
    set {usefulskripts::deathloc::%uuid of victim%} to location of victim

command /deathloc:
    executable by: players
    trigger:
        set {_loc} to {usefulskripts::deathloc::%uuid of player%}
        if {_loc} is not set:
            send "{@prefix}&eNo death location has been saved yet."
            stop
        send "{@prefix}&7World: &f%world of {_loc}%"
        send "{@prefix}&7Coordinates: &f%x-coordinate of {_loc}%, %y-coordinate of {_loc}%, %z-coordinate of {_loc}%"
