# ============================================================
# UsefulSkripts - DeathLocation
# Remember each player's last death coordinates.
# Requires: Skript 2.10+ and a compatible Minecraft server
# ============================================================

options:
    prefix: &8[&dDeathLoc&8] &7

# The last location persists across reloads and server restarts
# through Skript's variable storage.
on death of player:
    set {usefulskripts::deathloc::%uuid of player%} to location of player

command /deathloc:
    executable by: players
    trigger:
        set {_loc} to {usefulskripts::deathloc::%uuid of player%}
        if {_loc} is not set:
            send "{@prefix}&eNo death location has been saved yet."
            stop
        send "{@prefix}&7World: &f%world of {_loc}%"
        send "{@prefix}&7Coordinates: &f%x-coordinate of {_loc}%, %y-coordinate of {_loc}%, %z-coordinate of {_loc}%"
