options:
    prefix: &8[&7AFK&8] &7
    idle-minutes: 5 minutes
    movement-check-seconds: 10 seconds

on join:
    set {usefulskripts::afk::activity::%uuid of player%} to now
    delete {usefulskripts::afk::enabled::%uuid of player%}

on quit:
    delete {usefulskripts::afk::enabled::%uuid of player%}
    delete {usefulskripts::afk::activity::%uuid of player%}

command /afk:
    executable by: players
    trigger:
        if {usefulskripts::afk::enabled::%uuid of player%} is true:
            delete {usefulskripts::afk::enabled::%uuid of player%}
            set {usefulskripts::afk::activity::%uuid of player%} to now
            broadcast "{@prefix}&f%player% &7is no longer AFK."
        else:
            set {usefulskripts::afk::enabled::%uuid of player%} to true
            broadcast "{@prefix}&f%player% &7is now AFK."

on player move:
    if {usefulskripts::afk::activity::%uuid of player%} is set:
        if difference between now and {usefulskripts::afk::activity::%uuid of player%} < {@movement-check-seconds}:
            stop
    if block at past event-location is block at event-location:
        stop
    set {usefulskripts::afk::activity::%uuid of player%} to now
    if {usefulskripts::afk::enabled::%uuid of player%} is true:
        delete {usefulskripts::afk::enabled::%uuid of player%}
        broadcast "{@prefix}&f%player% &7is no longer AFK."

on chat:
    set {usefulskripts::afk::activity::%uuid of player%} to now
    if {usefulskripts::afk::enabled::%uuid of player%} is true:
        delete {usefulskripts::afk::enabled::%uuid of player%}
        broadcast "{@prefix}&f%player% &7is no longer AFK."

every 1 minute:
    loop all players:
        if {usefulskripts::afk::enabled::%uuid of loop-player%} is not true:
            if {usefulskripts::afk::activity::%uuid of loop-player%} is not set:
                set {usefulskripts::afk::activity::%uuid of loop-player%} to now
            if difference between now and {usefulskripts::afk::activity::%uuid of loop-player%} >= {@idle-minutes}:
                set {usefulskripts::afk::enabled::%uuid of loop-player%} to true
                broadcast "{@prefix}&f%loop-player% &7is now AFK."
