options:
    max-extra-logs: 48
    max-distance: 9
    require-permission: false
    require-leaves: false
    show-summary: true
    prefix: &8[&6TreeCapitator&8] &7

on break:
    if event is cancelled:
        stop
    if player's gamemode is creative:
        stop
    if player is not sneaking:
        stop
    if {@require-permission} is true:
        if player does not have permission "usefulskripts.treecapitator":
            stop
    if player's tool is not wooden axe or stone axe or copper axe or iron axe or golden axe or diamond axe or netherite axe:
        stop
    if {usefulskripts::treecap::busy::%uuid of player%} is true:
        stop

    if event-block is oak log or spruce log or birch log or jungle log or acacia log or dark oak log or mangrove log or cherry log or pale oak log:
        set {_kind} to type of event-block
    else:
        stop

    set {_origin} to location of event-block

    if {@require-leaves} is true:
        set {_leaves} to false
        loop blocks in radius 4 around {_origin}:
            if "%type of loop-block%" contains "leaves":
                set {_leaves} to true
                stop loop
        if {_leaves} is false:
            stop

    wait 1 tick
    if block at {_origin} is not air:
        stop
    if player is not online:
        stop

    set {usefulskripts::treecap::busy::%uuid of player%} to true
    set {_queue::1} to {_origin}
    set {_seen::%{_origin}%} to true
    set {_head} to 1
    set {_tail} to 1
    set {_count} to 0

    while {_head} <= {_tail}:
        if {_count} >= {@max-extra-logs}:
            stop loop
        set {_current} to {_queue::%{_head}%}
        add 1 to {_head}
        loop blocks in radius 1.75 around {_current}:
            if type of loop-block is {_kind}:
                set {_loc} to location of loop-block
                if distance between {_loc} and {_origin} <= {@max-distance}:
                    if {_seen::%{_loc}%} is not set:
                        set {_seen::%{_loc}%} to true
                        add 1 to {_tail}
                        set {_queue::%{_tail}%} to {_loc}
                        break loop-block naturally using player's tool
                        add 1 to {_count}
                        if {_count} >= {@max-extra-logs}:
                            stop loop

    delete {usefulskripts::treecap::busy::%uuid of player%}
    if {@show-summary} is true:
        if {_count} > 0:
            send "{@prefix}&aChopped %{_count}% additional logs."
        else:
            send "{@prefix}&eNo connected %{_kind}% logs found."
